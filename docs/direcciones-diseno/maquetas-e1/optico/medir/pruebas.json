 {
  "nombre": "arrastrar la lente dos muestras",
  "inicio": "#banco",
  "pasos": [
   [
    "js",
    "(async()=>{const b=document.querySelector('#lente-b'),r=b.getBoundingClientRect(),x=r.x+r.width/2,y=r.y+r.height/2,d=window.__paso();const ev=(t,dx)=>b.dispatchEvent(new PointerEvent(t,{bubbles:true,pointerId:7,button:0,clientX:x+dx,clientY:y}));ev('pointerdown',0);for(let k=1;k<=10;k++){ev('pointermove',d*2.1*k/10);await new Promise(r=>setTimeout(r,30));}ev('pointerup',d*2.1);})()",
    600
   ]
  ],
  "espera": {
   "ruta": "banco",
   "v.lx": 2,
   "lente": 2
  }
 },
 {
  "nombre": "arrastrar la lente con una muestra abierta",
  "inicio": "#wardux",
  "pasos": [
   [
    "js",
    "(async()=>{const b=document.querySelector('#lente-b'),r=b.getBoundingClientRect(),x=r.x+r.width/2,y=r.y+r.height/2,d=window.__paso();const ev=(t,dx)=>b.dispatchEvent(new PointerEvent(t,{bubbles:true,pointerId:7,button:0,clientX:x+dx,clientY:y}));ev('pointerdown',0);for(let k=1;k<=10;k++){ev('pointermove',d*1.2*k/10);await new Promise(r=>setTimeout(r,30));}ev('pointerup',d*1.2);})()",
    600
   ]
  ],
  "espera": {
   "ruta": "calculo",
   "v.lx": 2,
   "seleccion": 2,
   "ficha": true
  }
 },
