 {
  "nombre": "tráiler con color a 1440x900 (servidor)",
  "tam": [
   1440,
   900
  ],
  "inicio": "#cajon",
  "pasos": [
   [
    "ruta",
    "#servidor/cara-a",
    100
   ]
  ],
  "reposo": 2500,
  "espera": {
   "ruta": "servidor/cara-a",
   "enTele": "encendida"
  },
  "comprueba": "(() => { const t = document.querySelector('#tele .tr'); if (!t) return 'sin tráiler en la pantalla'; const cs = getComputedStyle(t), c = cs.getPropertyValue('--c').trim(), bg = cs.backgroundImage; if (!c || /^#0{3,6}$|^black$/i.test(c)) return `sin color (--c='${c}')`; if (bg === 'none') return 'fondo sin degradado (negro)'; return true; })()"
 },
